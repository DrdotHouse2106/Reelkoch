[Unit]
Description=Rezepte aus Reels
After=network-online.target

[Service]
User=rezepte
EnvironmentFile=/etc/rezepte.env
Environment=DATEN_DIR=/var/lib/rezepte HF_HOME=/var/lib/rezepte/modelle
WorkingDirectory=/opt/rezepte/app
ExecStart=/opt/rezepte/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
