# Kopie nach /etc/rezepte.env (chmod 600), niemals ins Repo
ANTHROPIC_API_KEY=
# IP des Reverse-Proxys, damit die Sperre nach Fehlversuchen die echte Absender-IP sieht
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional
# COOKIE_SECURE=0   # nur zum Testen ohne HTTPS
# CLAUDE_MODELL=claude-opus-5-5
# WHISPER_MODELL=small
# MAX_BILDER=15
# ERLAUBTE_HOSTS=facebook.com,fb.watch,instagram.com,tiktok.com
# PAPERLESS_URL=http://paperless.lan:8000
# PAPERLESS_TOKEN=
